# Firebase web config for the software-ambi project.
#
# Copy to .env.production for local production builds. The real file is
# gitignored; CI writes it from GitHub Actions repository variables (see
# .github/workflows/deploy.yml). These values are not secrets — Firebase web
# config ships inside the client bundle either way — but they are kept out of
# version control by project convention.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
